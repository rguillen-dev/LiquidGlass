{
  "mcpServers": {
    "xcodebuild": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "xcodebuildmcp@2.7.0",
        "mcp"
      ],
      "env": {}
    },
    "swift-dev-links": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "--directory",
        "${HOME}/Development/swift-dev-links",
        "run",
        "src/server.py"
      ]
    }
  }
}
